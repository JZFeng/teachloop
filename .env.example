# ---------- 必填 ----------
POSTGRES_PASSWORD=change-me
# DeepSeek 真实 AI 判分/解析（不填则 engine=ai 时调用失败，不写假分数）
DEEPSEEK_API_KEY=
# 生产务必设 false，避免创建演示账号
TEACHLOOP_SEED_ENABLED=false

# ---------- 数据库（compose 内可保持默认） ----------
DB_URL=jdbc:postgresql://db:5432/teachloop
DB_USER=teachloop
DB_PASSWORD=change-me
DB_POOL=10

# API Key 静态加密密钥（生产必须设置；变更后已保存的 AI Key 需要重新填写）
TEACHLOOP_SECURITY_SECRET=change-me-long-random

# ---------- 应用 ----------
# 生产必须 prod：开启 CSRF 双提交、资料补全拦截、Secure/SameSite Cookie
SPRING_PROFILES_ACTIVE=prod
PORT=8010
TZ=Asia/Shanghai
TEACHLOOP_GRADING_ENGINE=ai
TEACHLOOP_AI_CLIENT=spring-ai
TEACHLOOP_AI_MODEL=deepseek-flash
TEACHLOOP_AI_BASE_URL=https://api.deepseek.com
# 作文没有 rubric 时的默认比例：内容占 X%（1–99），语法与拼写占其余；默认 80/20（D-28）
TEACHLOOP_ESSAY_CONTENT_PERCENT=80

# ---------- 存储（T067） ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/uploads
# 生产对象存储（T386）：S3 兼容协议；backend=s3 时下面 endpoint / region / bucket / access-key 必填，
# 缺任一项启动即失败（报错只列缺失项名，不含密钥值）。本地 MinIO 用 make oss-dev + make test-oss。
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=cn-hangzhou
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_ACCESS_KEY_SECRET=
# 阿里云 OSS 只支持 virtual-hosted 风格 -> false；本地 MinIO 设 true
STORAGE_S3_PATH_STYLE=false
STORAGE_S3_PATH_PREFIX=teachloop/

# ---------- 可观测（T140–T144） ----------
OBSERVABILITY_LOG_DIR=/app/logs
TEACHLOOP_OBSERVABILITY_RETENTION_DAYS=90

# ---------- 背单词 · 本地词族索引（T388） ----------
# 原始词表 txt 与构建产物都不进 git：部署时用 `make vocab-lexicon` 生成后挂卷/复制进镜像。
# 目录不存在时词族区块降级隐藏（spec §8），不影响应用启动。
WORDLIST_INDEX_DIR=/app/fixtures-local/vocab-lexicon
VOCAB_LEXICON_ENABLED=true
# 详情页最多显示几个同族词（spec §14.4）
VOCAB_WORD_FAMILY_MAX_MEMBERS=8
# 新词内容异步生成（T394）：ai 默认；stub 仅测试/演示。预算按 Asia/Shanghai 当天已建 job 数。
VOCAB_GENERATION_ENABLED=true
VOCAB_GENERATION_ENGINE=ai
VOCAB_GENERATION_POLL_MS=2000
VOCAB_GENERATION_DAILY_BUDGET=2000
VOCAB_GENERATION_TIMEOUT_MS=60000

# ---------- 本地开发（不进容器） ----------
# JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
