<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.teachloop</groupId>
    <artifactId>teachloop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>teachloop-app</artifactId>
  <name>teachloop-app</name>
  <description>唯一启动模块：Spring Boot、Controller、装配</description>

  <dependencies>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-classroom</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-paper</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-sitting</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-grading</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-report</artifactId>
    </dependency>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-observability</artifactId>
    </dependency>
    <!-- 背单词模块骨架：只有 package-info，没有表与端口；接进来是为了让它的
         db/migration 目录进入 classpath（见下方 copy-migrations-vocab）。 -->
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-vocab</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-session-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 每个测试类一个 JVM：Testcontainers 的容器生命周期与 Spring context 缓存不能跨类复用，
               否则会拿到已停止容器的数据源（2026-10-21 全量回归出现的 InterruptedException/连接拒绝）。 -->
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-migrations-identity</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-identity/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-migrations-classroom</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-classroom/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-migrations-paper</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-paper/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-migrations-sitting</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-sitting/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-migrations-grading</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-grading/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-migrations-report</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-report/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-migrations-observability</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-observability/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- 骨架阶段该目录只有 .gitkeep：copy-resources 找不到 *.sql 时不会失败。
               与其它模块一样，这条 execution 漏了的话 fat jar 里就扫不到 vocab_* 迁移。 -->
          <execution>
            <id>copy-migrations-vocab</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/../teachloop-vocab/src/main/resources/db/migration</directory>
                  <includes><include>*.sql</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
