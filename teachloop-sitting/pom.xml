<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.teachloop</groupId>
    <artifactId>teachloop-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>teachloop-sitting</artifactId>
  <name>teachloop-sitting</name>
  <description>答卷：布置、参与班级、提交、客观分</description>

  <dependencies>
    <dependency>
      <groupId>com.teachloop</groupId>
      <artifactId>teachloop-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- T060：富文本 HTML 消毒（白名单），版本由 Lead 预下载 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.23.2</version>
    </dependency>
    <!-- T061：PDF 文本提取 -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <!-- T061：docx 文本提取 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.5.1</version>
    </dependency>
    <!-- T386：S3 协议对象存储（阿里云 OSS / MinIO 都兼容）；版本显式固定，Boot BOM 不管理 awssdk -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.57.3</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!-- T386：默认跳过 @Tag("oss") 的真实对象存储测试；-Poss（或 -DexcludedGroups=）才跑。 -->
    <excludedGroups>oss</excludedGroups>
  </properties>

  <profiles>
    <profile>
      <id>oss</id>
      <properties>
        <excludedGroups></excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
